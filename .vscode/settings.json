{
  // ============================================
  // WORKSPACE SETTINGS (.vscode/settings.json):
  // ============================================

  // ----------------------------------------------
  //      GIT SETTINGS

  // The main benefits of disabling "git" in VS COde:
  //
  //   - Performance: Faster VS Code, less background processing.
  //   - Clean UI: No Git status, markers, or prompts.
  //   - Consistency: Same workflow across tools/editors.
  //   - Advanced Features: Full Git power via CLI/tools.
  //   - Lower Resource Use: Less CPU/memory.
  //   - No Conflicts: Avoid VS Code vs. external Git state issues.

  "git.enabled": false, // Disable Git integration in VSCode

  // "git.autofetch": true,
  // "git.openRepositoryInParentFolders": "never",
  // "git.autorefresh": false, // Disable auto-refresh of Git repositories
  // "git.confirmSync": false, // Disable confirmation dialog for Git sync operations
  // "git.ignoreLimitWarning": true, // Ignore warnings about large Git repositories
  // "git.autofetch": false, // Disable auto-fetching of Git repositories
  // "git.enableSmartCommit": false, // Disable smart commit feature in Git
  // "git.enableCommitSigning": false, // Disable commit signing in Git


  // ----------------------------------------------
  //      FILES SETTINGS

  // "files.eol": "\n",
  "files.eol": "\n", // Use LF (Unix-style) line endings by default
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 30000, // Auto-save after 30 seconds
  "files.autoGuessEncoding": true,
  "files.insertFinalNewline": true, // Insert a final newline at the end of the file on save
  "files.trimTrailingWhitespace": true, // Trim trailing whitespace on save
  "files.trimFinalNewlines": true, // Trim final newlines on save
  "files.defaultLanguage": "plaintext", // Default language for new files. "Java"

  "files.associations": {
    "Justfile": "just",
    "Makefile": "make",
    "Dockerfile": "dockerfile",
    "docker-compose.yml": "docker-compose",
    // F# file associations
    "*.fs": "fsharp",
    "*.fsi": "fsharp",
    "*.fsx": "fsharp",
    "*.fsscript": "fsharp",
    // .NET project files
    "*.fsproj": "xml",
    "*.csproj": "xml",
    "*.sln": "plaintext",
    // Misc. file types
    "*.tsv": "tsv",
    "*.java": "java",
    "*.md": "markdown",
    "*.ahk2": "ahk2",
  },

  // List all files to be excluded from the workspace
  "files.exclude": {
    ".aider*": true,
    ".vscode--User-Settings--TO-BE-COPIED--settings.json": true,
    ".tmp-extensions--dir-cursor": true,
    ".tmp-extensions--dir-vscode": true,
    ".tmp-user-data-dir-cursor": true,
    ".tmp-user-data-dir-vscode": true,
    "target/": true,
    // git exclusions
    ".git": true,
    // Misc. files created by current plaform's OS:
    // "**/.DS_Store": true,
    // "**/Thumbs.db": true,
    // .NET specific exclusions
    // "**/bin/**": true,
    // "**/obj/**": true,
    // "**/packages/**": true,
    // "**/.vs/**": true
    // "**/*.fsproj.user": true,
    // "**/*.csproj.user": true,
  },

  // List all files to be excluded from "watcher" (file system watcher)
  // This is useful to prevent the editor from watching large directories
  // that can cause performance issues, such as node_modules or .git directories.
  "files.watcherExclude": {
    ".aider*": true,
    ".vscode--User-Settings--TO-BE-COPIED--settings.json": true,
    ".tmp-extensions--dir-cursor": true,
    ".tmp-extensions--dir-vscode": true,
    ".tmp-user-data-dir-cursor": true,
    ".tmp-user-data-dir-vscode": true,

    // .NET specific watcher exclusions
    "target/": true,

    // Git related exclusions
    ".git/": true,
    // "**/.git/objects/**": true,
    // "**/.git/subtree-cache/**": true,
  },


  // ----------------------------------------------
  //      WINDOW & WORKBENCH SETTINGS

  // Window settings:
  "window.density.editorTabHeight": "compact",

  // Workbench settings:
  "workbench.localHistory.enabled": true,
  "workbench.localHistory.mergeWindow": 60,
  "workbench.localHistory.maxFileEntries": 50,
  "workbench.localHistory.maxFileSize": 256, // Maximum file size in KB for local history

  "workbench.localHistory.exclude": {
    // Exclude specific files and directories from local history
    ".aider*": true,
    ".tmp-extensions--dir-cursor": true,
    ".tmp-extensions--dir-vscode": true,
    ".tmp-user-data-dir-cursor": true,
    ".tmp-user-data-dir-vscode": true,

    "target/": true,
    ".git/": true,
  },
  "timeline.pageSize": 50, // Number of entries to show in the timeline view


  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.showTabs": "none", // Do not show any tabs in the editor

  "workbench.editor.enablePreview": false,
  "workbench.panel.opensMaximized": "always",
  "workbench.editorAssociations": {
    // "*.db": "sqlite-viewer.option"
  },
  "workbench.tree.indent": 15,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.startupEditor": "none", // "welcomePage",

  "workbench.hover.delay": 1,
  "workbench.list.smoothScrolling": true,
  "workbench.colorTheme": "Default Dark Modern", // "Default Dark+",
  "workbench.iconTheme": "vscode-icons", // "vs-minimal",

  // The workbench.colorCustomizations setting allows you to
  // override colors from the currently selected "color theme".
  "workbench.colorCustomizations": {
    // Editor settings:
    "editor.background": "#282C34", // Colour of: Editor background.
    "editor.foreground": "#ABB2BF", // Colour of: Foreground text.
    "editor.selectionBackground": "#3E4451",
    "editor.lineHighlightBackground": "#333333",
    "editor.lineHighlightBorder": "#9fced11f",
    // EB: Is this settings doing anything for the cursor colour:
    //     "editorCursor.background": "#FFFFFF",
    "editorCursor.foreground": "#ff6a00",
    "editorLineNumber.activeForeground": "#A020F0",
    "editorLineNumber.foreground": "#23780e",
    "editorGutter.background": "#444444",
    "tree.indentGuidesStroke": "#05ef3c",
    // Misc.:
    "tab.activeBorder": "#F4DB01",
    // Editor: Scroll Bar
    // NOTE: 2023-11: There is currently no built-in feature or setting
    //       that allows you to change the color of the entire scrollbar area.
    "scrollbarSlider.background": "#ff930f",
    "scrollbarSlider.activeBackground": "#007acc",
    "scrollbarSlider.hoverBackground": "#5DE23C",
    // Title Bar:
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#F4DB01",
    "titleBar.inactiveBackground": "#000000",
    "titleBar.inactiveForeground": "#ffffff",
    "titleBar.border": "#666666",
    // Status Bar:
    "statusBar.background": "#000000",
    "statusBar.debuggingBackground": "#007acc",
    "statusBar.foreground": "#F4DB01",
    "statusBar.noFolderBackground": "#007acc",
    "statusBar.border": "#666666",
    // "Primary Side Bar":
    "sideBar.border": "#666666",
    "sideBar.background": "#333333",
    // Activity Bar:
    "activityBar.background": "#000000",
    "activityBar.foreground": "#F4DB01",
    "activityBar.border": "#666666"
  },

  // ----------------------------------------------
  //      EXPLORER & SEARCH SETTINGS

  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.openEditors.visible": 4,
  // "false":         Prevents the Explorer view from automatically revealing the currently open file.
  // "focusNoScroll": Focuses on the file but does not scroll the Explorer.
  "explorer.autoReveal": "focusNoScroll", // CTRL+SH+P: "Reveal Active File in Sidebar"

  "search.useIgnoreFiles": true, // Search respects "ignore files" like .gitignore

  // ----------------------------------------------
  //      EDITOR SETTINGS

  // EXPERIMENTAL: "editor.experimentalGpuAcceleration": "on",

  // Scale the editor: zoom to 120% size
  // NOTE: Each increment above 0 (e.g. 1) or below (e.g. -1)
  //       represents zooming 20% larger or smaller
  "window.zoomLevel": 1, // 1 : Increase with 20% (default is 0)

  // --- Font & Display ---
  // Make sure to install the "Cascadia Code NF" font on your platform from:
  //   https://github.com/microsoft/cascadia-code
  "editor.fontFamily": "'Cascadia Code NF', Consolas, 'Courier New', monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "editor.lineNumbers": "on", // Show line numbers. "off"
  "editor.showFoldingControls": "never", // "always", "mouseover"
  "editor.renderWhitespace": "boundary", // Show whitespace characters at boundaries. "trailing"
  "editor.renderControlCharacters": false, // Do not render control characters
  "editor.wrappingIndent": "none",
  "editor.renderLineHighlight": "line", // Highlight the current line. "gutter", "line", "all",
  "editor.smoothScrolling": false,

  // --- Indentation & Formatting ---
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "editor.indentSize": "tabSize", // Use editor.tabSize
  "editor.autoIndent": "full", // Enable full auto-indentation. "advanced"
  "editor.insertSpaces": true, // Insert spaces when pressing TAB
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true, // Format code on save
  "editor.formatOnType": false,
  "editor.detectIndentation": false,

  // --- Cursor & Selection ---
  "editor.cursorBlinking": "solid", // Smooth cursor blinking. "solid", "smooth"
  "editor.cursorStyle": "line", // Use a line cursor style
  "editor.cursorWidth": 3, // Set the width of the cursor
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorSurroundingLines": 10,
  "editor.cursorSurroundingLinesStyle": "default",
  "editor.multiCursorModifier": "ctrlCmd",
  // editor.multiCursorMergeOverlapping": true,
  // "editor.multiCursorPaste": "spread",

  // --- Suggestions & IntelliSense ---
  "editor.inlineSuggest.enabled": true,
  "editor.quickSuggestions": {
    "comments": "on",
    "strings": "on",
    "other": true // Enable suggestions for other content (e.g., comments)
  },
  "editor.suggest.showStatusBar": true,
  "editor.suggest.showIcons": true,
  "editor.suggest.preview": true,
  "editor.suggest.localityBonus": true, // Boosts suggestions closer to the cursor
  "editor.suggest.snippetsPreventQuickSuggestions": false, // Allows snippets to appear in quick suggestions
  // "editor.suggestSelection": "recentlyUsedByPrefix",
  "editor.suggestSelection": "recentlyUsedByPrefix", // Select the first suggestion by default. "first"
  "editor.snippetSuggestions": "top", // Show snippet suggestions at the top
  "editor.tabCompletion": "on", // Enable tab completion
  "editor.parameterHints.enabled": true,
  "editor.screenReaderAnnounceInlineSuggestion": false,
  "editor.codeActionWidget.includeNearbyQuickFixes": true,

  // --- Word Wrap & Rulers ---
  "editor.wordWrap": "on", // Enable word wrap
  "editor.wordWrapColumn": 120, // Set the column at which to wrap lines
  "editor.rulers": [ 80, 100, 120 ], // Show vertical rulers at columns 80, 100, and 120

  // --- Brackets & Guides ---
  "editor.guides.bracketPairs": true, // Show bracket pair guides in the editor
  // "editor.guides.bracketPairs": true, // This setting from file 1 is superseded by the one above
  "editor.guides.bracketPairsHorizontal": "active",
  "editor.guides.highlightActiveBracketPair": true, // Highlight the active bracket pair
  "editor.guides.highlightActiveIndentation": true,
  "editor.bracketPairColorization.enabled": false, // Disable bracket pair colorization to improve performance
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,

  // --- Scrolling & Minimap ---
  "editor.scrollBeyondLastColumn": 5, // Scroll beyond the last column by 5 characters
  "editor.scrollBeyondLastLine": true, // Scroll beyond the last line

  "editor.fastScrollSensitivity": 5,
  "editor.stickyScroll.enabled": true,

  "editor.minimap.enabled": false,
  "editor.minimap.autohide": true,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.scale": 1,
  "editor.minimap.showSlider": "mouseover",
  "editor.minimap.side": "right",

  "editor.scrollbar.verticalScrollbarSize": 14, // Set the size of the vertical scrollbar

  "editor.scrollbar.horizontalScrollbarSize": 14, // Set the size of the horizontal scrollbar

  "editor.scrollbar.scrollByPage": true,
  "editor.scrollbar.vertical": "visible", // Always show the vertical scrollbar
  "editor.scrollbar.horizontal": "visible", // Always show the horizontal scrollbar

  // --- Other Editor Settings ---
  "editor.find.autoFindInSelection": "multiline", // Other settings: "never" or "always"
  "editor.occurrencesHighlight": "singleFile",
  "editor.dragAndDrop": false,
  "editor.codeLens": true, // CodeLens in Visual Studio Code provides actionable contextual information
  "diffEditor.codeLens": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "multiDiffEditor.experimental.enabled": true, // Enable multi-diff editor
  "diffEditor.experimental.useTrueInlineView": true, // Render word changes inline

  // Hovering delay:
  "editor.hover.delay": 300,

  // Goto Location settings
  "editor.gotoLocation.multipleReferences": "goto",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleDeclarations": "goto",
  "editor.gotoLocation.multipleImplementations": "goto",
  "editor.gotoLocation.multipleTypeDefinitions": "goto",

  "accessibility.underlineLinks": true,

  // ------------------------------------------------
  //      TERMINAL SETTINGS

  "terminal.integrated.fontFamily": "'Cascadia Code PL', Consolas, 'Courier New', monospce",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.defaultProfile.linux": "bash", // "fish",
  "terminal.integrated.defaultLocation": "view", // OR: "editor"
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.gpuAcceleration": "off",
  "terminal.integrated.hideOnStartup": "always",

  // Terminal settings on Windows OS:
  // "terminal.external.windowsExec": "C:\\Windows\\System32\\bash.exe",
  // "terminal.integrated.shell.windows": "C:\\WINDOWS\\System32\\cmd.exe",
  // "terminal.integrated.shell.windows": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
  // "terminal.integrated.shell.windows": "C:\\Program Files\\Git\\bin\\bash.exe",

  // Terminal settings for .NET CLI
  "terminal.integrated.env.windows": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },
  "terminal.integrated.env.osx": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },
  "terminal.integrated.env.linux": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },

  // ------------------------------------------------
  //      EXTENSION & MISC SETTINGS

  // --- General ---
  "testing.automaticallyOpenPeekView": "never",

  "debug.toolBarLocation": "commandCenter",
  "breadcrumbs.enabled": false,
  "zenMode.hideActivityBar": false,
  "remote.autoForwardPortsSource": "hybrid",
  "json.format.keepLines": true,

  // --- Extension Management ---
  "extensions.ignoreRecommendations": true,

  // --- VSCode Icons ---
  "vsicons.dontShowNewVersionMessage": true,
  // EB: What is a working value for "root_folder"? :
  // "vsicons.associations.folderDefault.root_folder": "folder",

  // --- Just ---
  "vscode-just.runInTerminal": true,
  "vscode-just.useSingleTerminal": true,


  // --- .NET / F# ---
  "FSharp.enableTreeView": true,
  "FSharp.enableMSBuildProjectGraph": true,
  "FSharp.workspaceModePeekDeepLevel": 2,
  "FSharp.workspacePath": "${workspaceFolder}",
  "FSharp.excludeProjectDirectories": [
    ".tmp-extensions--dir-cursor",
    ".tmp-extensions--dir-vscode",
    ".tmp-user-data-dir-cursor",
    ".tmp-user-data-dir-vscode",
    ".git",
    "paket-files",
    ".fable",
    "packages",
    "bin",
    "obj"
  ],

  // --- C# ---
  // "csharp.suppressHiddenDiagnostics": true,
  "omnisharp.enableEditorConfigSupport": true,
  "omnisharp.useModernNet": true,
  "omnisharp.enableMsBuildLoadProjectsOnDemand": true,
  "dotnet.completion.showCompletionItemsFromUnimportedNamespaces": true,
  "dotnet.codeLens.enableReferencesCodeLens": false, // Matches your codeLens: false preference

  // --- Other Extensions ---
  // "dev.containers.defaultFeatures": {},
  "roo-cline.allowedCommands": [
    "npm test",
    "npm install",
    "tsc",
    "git log",
    "git diff",
    "git show"
  ],
  "remote.defaultExtensionsIfInstalledLocally": [ ],

  // ------------------------------------------------
  //      LANGUAGE-SPECIFIC SETTINGS

  "[java]": {
    //"editor.defaultFormatter": "redhat.java"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[javascript]": {
    // "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[plaintext]": {
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false
  },
  // "[dockerfile]": {
  //  "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  // },
  "[python]": {
    // "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.defaultColorDecorators": "never",
    "editor.wordBasedSuggestions": "off"
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[fsharp]": {
    "editor.defaultFormatter": "Ionide.Ionide-fsharp",
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.formatOnType": false,
    "editor.formatOnPaste": true
  },
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.detectIndentation": false,
    "editor.formatOnSave": true
  },
  "[just]": {
    //  Justfile requires TAB for indentation, not SPACEs.
    "editor.insertSpaces": false,
    "editor.detectIndentation": false
  },
  "[ignore]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },

}
